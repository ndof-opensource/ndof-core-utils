{
    "name": "ndof-core",
    // Digest-pinned dev environment. This line is the only place the image
    // digest lives: your editor starts the container from it and the
    // reusable CI reads it from here. Bumped by hand when adopting a new
    // image; Dependabot does not scan this file.
    "image": "ghcr.io/ndof-opensource/ndof-dev@sha256:1f9fe6a18d09bbee586c0a9ca0d8b4c589c3fb229a3fe425cbff8dc69dbc3dce",
    "remoteUser": "dev",
    // Spec default, stated explicitly because Linux hosts depend on it: at
    // create time the tool rebuilds the image with dev's uid/gid remapped to
    // the host user's, keeping the bind-mounted checkout writable. VS Code
    // and the devcontainer CLI honor this reliably; Zed has open bugs here.
    "updateRemoteUserUID": true,
    // Editor-agnostic tooling config lives in editor-agnostic files: clangd
    // is configured by the repo's .clangd (every editor honors it). This
    // block carries VS Code niceties only.
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools"
            ]
        }
    }
}
